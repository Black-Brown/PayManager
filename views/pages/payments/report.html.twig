{% extends "layout.html.twig" %}

{% block content %}
<div class="container-fluid">
    <div class="card shadow-sm mt-4">
        <div class="card-header bg-primary text-white py-3 d-flex justify-content-between align-items-center">
            <h5 class="card-title mb-0">
                <i class="fas fa-chart-bar me-2"></i>Reporte de Pagos
            </h5>
            <div class="d-flex gap-2">
                <a href="/payments" class="btn btn-light text-primary">
                    <i class="fas fa-arrow-left me-2"></i>Volver a Pagos
                </a>
            </div>
        </div>
        <div class="card-body">
            <!-- Filtros -->
            <div class="row mb-4">
                <div class="col-md-12">
                    <form method="GET" action="/payments/report" class="row g-3">
                        <div class="col-md-4">
                            <label for="start_date" class="form-label">Fecha Inicio</label>
                            <input type="date" 
                                   class="form-control" 
                                   id="start_date" 
                                   name="start_date" 
                                   value="{{ startDate }}">
                        </div>
                        <div class="col-md-4">
                            <label for="end_date" class="form-label">Fecha Fin</label>
                            <input type="date" 
                                   class="form-control" 
                                   id="end_date" 
                                   name="end_date" 
                                   value="{{ endDate }}">
                        </div>
                        <div class="col-md-4 d-flex align-items-end">
                            <button type="submit" class="btn btn-primary me-2">
                                <i class="fas fa-search me-2"></i>Filtrar
                            </button>
                            <a href="/payments/report" class="btn btn-outline-secondary">
                                <i class="fas fa-refresh me-2"></i>Limpiar
                            </a>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Resumen -->
            <div class="row mb-4">
                <div class="col-md-4">
                    <div class="card bg-success text-white">
                        <div class="card-body text-center">
                            <i class="fas fa-dollar-sign fa-2x mb-2"></i>
                            <h5 class="card-title">Total Recaudado</h5>
                            <h3 class="mb-0">${{ totalAmount|number_format(2) }}</h3>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card bg-info text-white">
                        <div class="card-body text-center">
                            <i class="fas fa-receipt fa-2x mb-2"></i>
                            <h5 class="card-title">Total Pagos</h5>
                            <h3 class="mb-0">{{ payments|length }}</h3>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card bg-warning text-dark">
                        <div class="card-body text-center">
                            <i class="fas fa-calculator fa-2x mb-2"></i>
                            <h5 class="card-title">Promedio por Pago</h5>
                            <h3 class="mb-0">
                                {% if payments|length > 0 %}
                                    ${{ (totalAmount / payments|length)|number_format(2) }}
                                {% else %}
                                    $0.00
                                {% endif %}
                            </h3>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Tabla de Pagos -->
            {% if payments %}
                <div class="table-responsive">
                    <table class="table table-hover table-striped">
                        <thead class="table-light">
                            <tr>
                                <th class="text-center">#</th>
                                <th>Estudiante</th>
                                <th>Concepto</th>
                                <th>Monto</th>
                                <th>Fecha</th>
                                <th>Método</th>
                                <th class="text-center">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for payment in payments %}
                            <tr>
                                <td class="text-center fw-bold text-muted">{{ loop.index }}</td>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <div class="avatar-sm bg-primary text-white rounded-circle d-flex align-items-center justify-content-center me-2">
                                            {{ payment.student_name|slice(0,1)|upper }}
                                        </div>
                                        <div>
                                            <div class="fw-semibold">{{ payment.student_name }}</div>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span class="badge bg-info">{{ payment.concept_name }}</span>
                                    <br>
                                    <small class="text-muted">{{ payment.concept_type }}</small>
                                </td>
                                <td class="fw-bold text-success">${{ payment.amount|number_format(2) }}</td>
                                <td>{{ payment.payment_date|date('d/m/Y') }}</td>
                                <td>
                                    <span class="badge bg-secondary">{{ payment.payment_method }}</span>
                                </td>
                                <td class="text-center">
                                    <a href="/payments/{{ payment.id }}" 
                                       class="btn btn-sm btn-outline-info" 
                                       title="Ver detalle">
                                        <i class="fas fa-eye"></i>
                                    </a>
                                </td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% else %}
                <div class="text-center py-5">
                    <div class="mb-3"><i class="fas fa-chart-bar fa-3x text-muted"></i></div>
                    <h5 class="text-muted">No se encontraron pagos en el período seleccionado</h5>
                    <p class="text-muted mb-4">Intenta ajustar las fechas del filtro</p>
                </div>
            {% endif %}
        </div>
        {% if payments %}
        <div class="card-footer bg-light text-muted">
            <div class="row">
                <div class="col-md-6">
                    <small><i class="fas fa-info-circle me-1"></i>Período: {{ startDate|date('d/m/Y') }} - {{ endDate|date('d/m/Y') }}</small>
                </div>
                <div class="col-md-6 text-end">
                    <small>Total de pagos: {{ payments|length }} | Monto total: ${{ totalAmount|number_format(2) }}</small>
                </div>
            </div>
        </div>
        {% endif %}
    </div>
</div>
{% endblock %}
