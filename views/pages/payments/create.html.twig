{% extends "layout.html.twig" %}

{% block title %}Registrar Pago{% endblock %}

{% block content %}
<div class="container-fluid">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <!-- Mensajes de Error -->
            {% if error %}
                <div class="alert alert-danger alert-dismissible fade show mt-3" role="alert">
                    <i class="fas fa-exclamation-triangle me-2"></i>{{ error }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            {% endif %}

            <div class="card shadow-sm mt-4 mb-4">
                <div class="card-header bg-primary text-white py-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <h5 class="card-title mb-0">
                            <i class="fas fa-money-check-alt me-2"></i>Registrar Nuevo Pago
                        </h5>
                        <a href="/payments" class="btn btn-light btn-sm">
                            <i class="fas fa-arrow-left me-2"></i>Volver
                        </a>
                    </div>
                </div>

                <div class="card-body p-4">
                    <form action="/payments" method="POST" id="paymentForm" novalidate>
                        <!-- Sección: Información del Estudiante -->
                        <div class="row mb-4">
                            <div class="col-12">
                                <h6 class="text-primary border-bottom pb-2 mb-3">
                                    <i class="fas fa-user-graduate me-2"></i>Información del Estudiante
                                </h6>
                            </div>
                            
                            <div class="col-md-12 mb-3">
                                <label for="student_id" class="form-label fw-semibold">
                                    <i class="fas fa-user me-1"></i>Estudiante 
                                    <span class="text-danger">*</span>
                                </label>
                                <select class="form-select form-select-lg" id="student_id" name="student_id" required>
                                    <option value="">-- Seleccione un estudiante --</option>
                                    {% for student in students %}
                                        <option value="{{ student.id }}" 
                                            {% if old.student_id == student.id or preselected_student_id == student.id %}selected{% endif %}>
                                            {{ student.first_name }} {{ student.last_name }}
                                        </option>
                                    {% endfor %}
                                </select>
                                <div class="form-text">
                                    <i class="fas fa-info-circle me-1"></i>Seleccione el estudiante que realiza el pago
                                </div>
                            </div>
                        </div>

                        <!-- Sección: Detalles del Pago -->
                        <div class="row mb-4">
                            <div class="col-12">
                                <h6 class="text-primary border-bottom pb-2 mb-3">
                                    <i class="fas fa-file-invoice-dollar me-2"></i>Detalles del Pago
                                </h6>
                            </div>

                            <!-- Concepto -->
                            <div class="col-md-6 mb-3">
                                <label for="concept_id" class="form-label fw-semibold">
                                    <i class="fas fa-tag me-1"></i>Concepto de Pago
                                    <span class="text-danger">*</span>
                                </label>
                                <select class="form-select" id="concept_id" name="concept_id" required>
                                    <option value="">-- Seleccione un concepto --</option>
                                    {% for concept in concepts %}
                                        <option value="{{ concept.id }}" 
                                            {% if old.concept_id == concept.id or (preselected_concept_type and concept.type == preselected_concept_type) %}selected{% endif %}>
                                            {{ concept.name }} ({{ concept.type }})
                                        </option>
                                    {% endfor %}
                                </select>
                                <div class="form-text">Tipo de pago a registrar</div>
                            </div>

                            <!-- Monto -->
                            <div class="col-md-6 mb-3">
                                <label for="amount" class="form-label fw-semibold">
                                    <i class="fas fa-dollar-sign me-1"></i>Monto
                                    <span class="text-danger">*</span>
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text">$</span>
                                    <input type="number" 
                                           step="0.01" 
                                           min="0.01"
                                           class="form-control" 
                                           id="amount" 
                                           name="amount" 
                                           placeholder="0.00"
                                           value="{{ old.amount }}"
                                           required>
                                </div>
                                <div class="form-text">Ingrese el monto del pago</div>
                            </div>

                            <!-- Fecha de Pago -->
                            <div class="col-md-6 mb-3">
                                <label for="payment_date" class="form-label fw-semibold">
                                    <i class="fas fa-calendar-check me-1"></i>Fecha de Pago
                                    <span class="text-danger">*</span>
                                </label>
                                <input type="date" 
                                       class="form-control" 
                                       id="payment_date" 
                                       name="payment_date"
                                       value="{{ old.payment_date }}"
                                       required>
                                <div class="form-text">Fecha en que se realizó el pago</div>
                            </div>

                            <!-- Mes Correspondiente -->
                            <div class="col-md-6 mb-3">
                                <label for="corresponding_month" class="form-label fw-semibold">
                                    <i class="fas fa-calendar-alt me-1"></i>Mes Correspondiente
                                    <span class="text-danger">*</span>
                                </label>
                                <input type="month" 
                                       class="form-control" 
                                       id="corresponding_month" 
                                       name="corresponding_month"
                                       value="{{ old.corresponding_month|default(preselected_month) }}"
                                       required>
                                <div class="form-text">Mes al que corresponde el pago</div>
                            </div>
                        </div>

                        <!-- Sección: Información Adicional -->
                        <div class="row mb-4">
                            <div class="col-12">
                                <h6 class="text-primary border-bottom pb-2 mb-3">
                                    <i class="fas fa-info-circle me-2"></i>Información Adicional
                                </h6>
                            </div>

                            <!-- Método de Pago -->
                            <div class="col-md-6 mb-3">
                                <label for="payment_method" class="form-label fw-semibold">
                                    <i class="fas fa-credit-card me-1"></i>Método de Pago
                                </label>
                                <select class="form-select" id="payment_method" name="payment_method">
                                    <option value="Cash" {% if old.payment_method == 'Cash' %}selected{% endif %}>
                                        Efectivo
                                    </option>
                                    <option value="Card" {% if old.payment_method == 'Card' %}selected{% endif %}>
                                        Tarjeta
                                    </option>
                                    <option value="Transfer" {% if old.payment_method == 'Transfer' %}selected{% endif %}>
                                        Transferencia
                                    </option>
                                    <option value="Other" {% if old.payment_method == 'Other' %}selected{% endif %}>
                                        Otro
                                    </option>
                                </select>
                                <div class="form-text">Forma de pago utilizada</div>
                            </div>

                            <!-- Comprobante -->
                            <div class="col-md-6 mb-3">
                                <label for="reference" class="form-label fw-semibold">
                                    <i class="fas fa-receipt me-1"></i>Comprobante / Referencia
                                </label>
                                <input type="text" 
                                       class="form-control" 
                                       id="reference" 
                                       name="reference" 
                                       maxlength="100"
                                       placeholder="Ej: REC001, TRANS-12345"
                                       value="{{ old.reference }}">
                                <div class="form-text">Número de referencia o comprobante (opcional)</div>
                            </div>

                            <!-- Notas -->
                            <div class="col-md-12 mb-3">
                                <label for="notes" class="form-label fw-semibold">
                                    <i class="fas fa-sticky-note me-1"></i>Notas / Observaciones
                                </label>
                                <textarea class="form-control" 
                                          id="notes" 
                                          name="notes" 
                                          rows="4"
                                          placeholder="Agregue cualquier información adicional relevante sobre este pago...">{{ old.notes }}</textarea>
                                <div class="form-text">Información adicional (opcional)</div>
                            </div>
                        </div>

                        <!-- Botones de Acción -->
                        <div class="row">
                            <div class="col-12">
                                <div class="card bg-light">
                                    <div class="card-body">
                                        <div class="d-flex justify-content-between align-items-center">
                                            <div class="text-muted">
                                                <small>Los campos marcados con <span class="text-danger fw-bold">*</span> son obligatorios</small>
                                            </div>
                                            <div class="btn-group" role="group">
                                              <a href="/payments" class="btn btn-outline-secondary">
                                                <i class="fas fa-arrow-left me-2"></i>Cancelar
                                              </a>
                                              <button type="submit" class="btn btn-primary">
                                                <i class="fas fa-save me-2"></i>Registrar Pago
                                              </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Card de Ayuda -->
            <div class="card border-info mb-4">
                <div class="card-header bg-info text-white">
                    <h6 class="mb-0">
                        <i class="fas fa-lightbulb me-2"></i>Consejos para registrar pagos
                    </h6>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <ul class="mb-0">
                                <li><strong>Verifica los datos</strong> del estudiante antes de guardar</li>
                                <li>Asegúrate de que el <strong>monto sea correcto</strong></li>
                                <li>Selecciona el <strong>mes correspondiente</strong> apropiado</li>
                            </ul>
                        </div>
                        <div class="col-md-6">
                            <ul class="mb-0">
                                <li>Registra siempre el <strong>comprobante</strong> cuando sea posible</li>
                                <li>Usa las <strong>notas</strong> para información relevante</li>
                                <li>Podrás aplicar <strong>descuentos</strong> después de crear el pago</li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
// Establecer fecha actual por defecto e inicializar Select2
document.addEventListener('DOMContentLoaded', function() {
    // Inicializar Select2 en el select de estudiantes
    $('#student_id').select2({
        theme: 'bootstrap-5',
        placeholder: 'Buscar estudiante por nombre...',
        allowClear: true,
        width: '100%',
        language: {
            noResults: function() {
                return "No se encontraron estudiantes";
            },
            searching: function() {
                return "Buscando...";
            },
            inputTooShort: function() {
                return "Escribe para buscar...";
            }
        }
    });

    // Inicializar Select2 en el select de conceptos
    $('#concept_id').select2({
        theme: 'bootstrap-5',
        placeholder: 'Buscar concepto de pago...',
        allowClear: true,
        width: '100%',
        language: {
            noResults: function() {
                return "No se encontraron conceptos";
            },
            searching: function() {
                return "Buscando...";
            }
        }
    });

    const paymentDateInput = document.getElementById('payment_date');
    const correspondingMonthInput = document.getElementById('corresponding_month');
    
    if (!paymentDateInput.value) {
        const today = new Date().toISOString().split('T')[0];
        paymentDateInput.value = today;
    }
    
    if (!correspondingMonthInput.value) {
        const currentMonth = new Date().toISOString().slice(0, 7);
        correspondingMonthInput.value = currentMonth;
    }
    
    // Validación básica del formulario
    document.getElementById('paymentForm').addEventListener('submit', function(e) {
        const amount = document.getElementById('amount').value;
        if (parseFloat(amount) <= 0) {
            e.preventDefault();
            alert('El monto debe ser mayor a cero');
            return false;
        }
    });
});
</script>
{% endblock %}