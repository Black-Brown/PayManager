{% extends "layout.html.twig" %}

{% block title %}Registrar Pago{% endblock %}

{% block content %}
<div class="container-fluid">
  <div class="card shadow-sm mt-4 mb-4">
    <div class="card-header bg-success text-white py-3">
      <h5 class="card-title mb-0">
        <i class="fas fa-money-check-alt me-2"></i>Registrar Nuevo Pago
      </h5>
    </div>
    <div class="card-body">
      <form action="/payments" method="POST" id="paymentForm" novalidate>
        <div class="row">
        {% if error %}
            <div class="alert alert-danger">
                <i class="fas fa-exclamation-triangle me-2"></i>{{ error }}
            </div>
        {% endif %}

          <!-- Estudiante -->
          <div class="col-md-6 mb-4">
            <label for="student_id" class="form-label fw-semibold">Estudiante <span class="text-danger">*</span></label>
            <select class="form-control" id="student_id" name="student_id" required>
              <option value="">Seleccione un estudiante</option>
              {% for student in students %}
              <option value="{{ student.id }}">{{ student.first_name }} {{ student.last_name }}</option>
              {% endfor %}
            </select>
          </div>

          <!-- Concepto de pago -->
          <div class="col-md-6 mb-4">
            <label for="concept_id" class="form-label fw-semibold">Concepto <span class="text-danger">*</span></label>
            <select class="form-control" id="concept_id" name="concept_id" required>
              <option value="">Seleccione un concepto</option>
              {% for concept in concepts %}
              <option value="{{ concept.id }}">{{ concept.name }} ({{ concept.type }})</option>
              {% endfor %}
            </select>
          </div>

          <!-- Monto -->
          <div class="col-md-6 mb-4">
            <label for="amount" class="form-label fw-semibold">Monto <span class="text-danger">*</span></label>
            <input type="number" step="0.01" class="form-control" id="amount" name="amount" required>
          </div>

          <!-- Fecha de pago -->
          <div class="col-md-6 mb-4">
            <label for="payment_date" class="form-label fw-semibold">Fecha de Pago <span class="text-danger">*</span></label>
            <input type="date" class="form-control" id="payment_date" name="payment_date" required>
          </div>

          <!-- Mes correspondiente -->
          <div class="col-md-6 mb-4">
            <label for="corresponding_month" class="form-label fw-semibold">Mes Correspondiente <span class="text-danger">*</span></label>
            <input type="month" class="form-control" id="corresponding_month" name="corresponding_month" required>
          </div>

          <!-- Método de pago -->
          <div class="col-md-6 mb-4">
            <label for="payment_method" class="form-label fw-semibold">Método de Pago</label>
            <select class="form-control" id="payment_method" name="payment_method">
              <option value="Cash">Efectivo</option>
              <option value="Card">Tarjeta</option>
              <option value="Transfer">Transferencia</option>
              <option value="Other">Otro</option>
            </select>
          </div>

          <!-- Referencia -->
          <div class="col-md-6 mb-4">
            <label for="reference" class="form-label fw-semibold">Referencia</label>
            <input type="text" class="form-control" id="reference" name="reference" maxlength="100">
          </div>

          <!-- Notas -->
          <div class="col-md-12 mb-4">
            <label for="notes" class="form-label fw-semibold">Notas</label>
            <textarea class="form-control" id="notes" name="notes" rows="3"></textarea>
          </div>

        <!-- Botones -->
        <div class="row mt-4">
          <div class="col-12">
            <div class="d-flex justify-content-between align-items-center border-top pt-3">
              <div class="text-muted small">
                <i class="fas fa-asterisk me-1"></i>Los campos marcados con <span class="text-danger">*</span> son obligatorios
              </div>
              <div class="btn-group" role="group">
                <a href="/payments" class="btn btn-outline-secondary">
                  <i class="fas fa-arrow-left me-2"></i>Cancelar
                </a>
                <button type="submit" class="btn btn-success">
                  <i class="fas fa-save me-2"></i>Registrar Pago
                </button>
              </div>
            </div>
          </div>
        </div>

        </div>
      </form>
    </div>
  </div>
</div>
{% endblock %}
