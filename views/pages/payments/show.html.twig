{% extends "layout.html.twig" %}

{% block content %}
<div class="container-fluid">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <!-- Mensajes Flash -->
            {% if flash.success %}
                <div class="alert alert-success alert-dismissible fade show mt-3" role="alert">
                    <i class="fas fa-check-circle me-2"></i>{{ flash.success }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            {% endif %}
            
            {% if flash.error %}
                <div class="alert alert-danger alert-dismissible fade show mt-3" role="alert">
                    <i class="fas fa-exclamation-circle me-2"></i>{{ flash.error }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            {% endif %}

            <div class="card shadow-sm mt-4 mb-4">
                <div class="card-header bg-primary text-white py-3 d-flex justify-content-between align-items-center">
                    <h5 class="card-title mb-0">
                        <i class="fas fa-eye me-2"></i>Detalle del Pago #{{ payment.id }}
                    </h5>
                    <div class="d-flex gap-2">
                        <a href="/payments/{{ payment.id }}/edit" class="btn btn-light text-primary">
                            <i class="fas fa-edit me-2"></i>Editar
                        </a>
                        <a href="/payments" class="btn btn-light text-primary">
                            <i class="fas fa-arrow-left me-2"></i>Volver
                        </a>
                    </div>
                </div>
                <div class="card-body">
                    <div class="row">
                        <!-- Información del Pago -->
                        <div class="col-md-8">
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-bold text-muted">Estudiante</label>
                                    <div class="d-flex align-items-center">
                                        <div class="avatar-sm bg-primary text-white rounded-circle d-flex align-items-center justify-content-center me-3">
                                            {{ payment.student_name|slice(0,1)|upper }}
                                        </div>
                                        <div>
                                            <div class="fw-semibold">{{ payment.student_name }}</div>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-bold text-muted">Concepto de Pago</label>
                                    <div>
                                        <span class="badge bg-info fs-6">{{ payment.concept_name }}</span>
                                        <br>
                                        <small class="text-muted">{{ payment.concept_type }}</small>
                                    </div>
                                </div>

                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-bold text-muted">Monto Original</label>
                                    <div class="fs-5 fw-bold text-success">${{ payment.amount|number_format(2) }}</div>
                                </div>

                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-bold text-muted">Monto Final</label>
                                    <div class="fs-5 fw-bold text-primary">${{ payment.total_amount|number_format(2) }}</div>
                                    {% if payment.hasDiscounts() %}
                                        <small class="text-warning">
                                            <i class="fas fa-tag me-1"></i>Con descuentos aplicados
                                        </small>
                                    {% endif %}
                                </div>

                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-bold text-muted">Fecha de Pago</label>
                                    <div>{{ payment.payment_date|date('d/m/Y') }}</div>
                                </div>

                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-bold text-muted">Mes Correspondiente</label>
                                    <div>{{ payment.corresponding_month|date('F Y') }}</div>
                                </div>

                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-bold text-muted">Método de Pago</label>
                                    <br>
                                    <span class="badge bg-secondary">{{ payment.payment_method }}</span>
                                </div>

                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-bold text-muted">Registrado por</label>
                                    <div>{{ payment.registered_by }}</div>
                                </div>

                                {% if payment.reference %}
                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-bold text-muted">Comprobante</label>
                                    <div class="text-break">{{ payment.reference }}</div>
                                </div>
                                {% endif %}

                                {% if payment.notes %}
                                <div class="col-12 mb-3">
                                    <label class="form-label fw-bold text-muted">Notas</label>
                                    <div class="bg-light p-3 rounded">{{ payment.notes }}</div>
                                </div>
                                {% endif %}
                            </div>
                        </div>

                        <!-- Panel de Descuentos -->
                        <div class="col-md-4">
                            <div class="card border-warning mb-3">
                                <div class="card-header bg-warning text-dark">
                                    <h6 class="mb-0">
                                        <i class="fas fa-tag me-2"></i>Descuentos
                                    </h6>
                                </div>
                                <div class="card-body">
                                    {% if discounts is not empty %}
                                        {% for discount in discounts %}
                                        <div class="d-flex justify-content-between align-items-start mb-2 p-2 bg-light rounded">
                                            <div class="flex-grow-1">
                                                <div class="fw-semibold text-danger">-${{ discount.discount_amount|number_format(2) }}</div>
                                                <small class="text-muted d-block">{{ discount.reason }}</small>
                                                <small class="text-muted">{{ discount.created_at|date('d/m/Y') }}</small>
                                            </div>
                                            <div class="ms-2">
                                                <a href="/payments/{{ payment.id }}/discount/{{ discount.id }}/delete" 
                                                   class="btn btn-sm btn-outline-danger"
                                                   onclick="return confirm('¿Eliminar este descuento?');"
                                                   title="Eliminar descuento">
                                                    <i class="fas fa-trash"></i>
                                                </a>
                                            </div>
                                        </div>
                                        {% endfor %}
                                        
                                        <!-- Mostrar total de descuentos -->
                                        <hr>
                                        <div class="d-flex justify-content-between align-items-center">
                                            <strong>Total Descuentos:</strong>
                                            <span class="text-danger fw-bold">
                                                -${% set total_discount = 0 %}
                                                {% for discount in discounts %}
                                                    {% set total_discount = total_discount + discount.discount_amount %}
                                                {% endfor %}
                                                {{ total_discount|number_format(2) }}
                                            </span>
                                        </div>
                                    {% else %}
                                        <div class="text-center text-muted py-3">
                                            <i class="fas fa-tag fa-2x mb-2"></i>
                                            <p class="mb-0">Sin descuentos aplicados</p>
                                        </div>
                                    {% endif %}

                                    {% if concept and concept.allowsDiscount() %}
                                    <hr>
                                    <button class="btn btn-warning btn-sm w-100" 
                                            data-bs-toggle="modal" 
                                            data-bs-target="#discountModal">
                                        <i class="fas fa-plus me-2"></i>Aplicar Descuento
                                    </button>
                                    {% endif %}
                                </div>
                            </div>

                            <!-- Panel de Información Adicional -->
                            <div class="card border-primary">
                                <div class="card-header bg-primary text-white">
                                    <h6 class="mb-0">
                                        <i class="fas fa-info-circle me-2"></i>Información Adicional
                                    </h6>
                                </div>
                                <div class="card-body">
                                    <div class="mb-3">
                                        <small class="text-muted">ID del Pago</small>
                                        <div class="fw-semibold">#{{ payment.id }}</div>
                                    </div>
                                    
                                    <div class="mb-3">
                                        <small class="text-muted">Fecha de Registro</small>
                                        <div class="fw-semibold">{{ payment.created_at|date('d/m/Y H:i') }}</div>
                                    </div>

                                    {% if payment.updated_at != payment.created_at %}
                                    <div class="mb-3">
                                        <small class="text-muted">Última Actualización</small>
                                        <div class="fw-semibold">{{ payment.updated_at|date('d/m/Y H:i') }}</div>
                                    </div>
                                    {% endif %}

                                    <hr>
                                    <div class="text-center">
                                        <a href="/payments/student/{{ payment.student_id }}" class="btn btn-outline-primary btn-sm w-100 mb-2">
                                            <i class="fas fa-user me-2"></i>Ver Pagos del Estudiante
                                        </a>
                                        
                                        {% if discounts is not empty %}
                                        <a href="/payments/{{ payment.id }}/discounts" class="btn btn-outline-warning btn-sm w-100">
                                            <i class="fas fa-list me-2"></i>Ver Todos los Descuentos
                                        </a>
                                        {% endif %}
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal para aplicar descuento -->
{% if concept and concept.allowsDiscount() %}
<div class="modal fade" id="discountModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-warning text-dark">
                <h5 class="modal-title">
                    <i class="fas fa-tag me-2"></i>Aplicar Descuento
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form method="POST" action="/payments/{{ payment.id }}/discount">
                <div class="modal-body">
                    <div class="alert alert-info">
                        <small>
                            <strong>Monto Original:</strong> ${{ payment.amount|number_format(2) }}<br>
                            {% if discounts is not empty %}
                                {% set total_discount = 0 %}
                                {% for discount in discounts %}
                                    {% set total_discount = total_discount + discount.discount_amount %}
                                {% endfor %}
                                <strong>Descuentos Aplicados:</strong> -${{ total_discount|number_format(2) }}<br>
                                <strong>Disponible para Descuento:</strong> ${{ (payment.amount - total_discount)|number_format(2) }}
                            {% else %}
                                <strong>Disponible para Descuento:</strong> ${{ payment.amount|number_format(2) }}
                            {% endif %}
                        </small>
                    </div>
                    
                    <div class="mb-3">
                        <label for="discount_amount" class="form-label">Monto del Descuento</label>
                        <div class="input-group">
                            <span class="input-group-text">$</span>
                            <input type="number" 
                                   class="form-control" 
                                   id="discount_amount" 
                                   name="discount_amount" 
                                   step="0.01" 
                                   min="0.01" 
                                   max="{{ payment.amount }}" 
                                   required>
                        </div>
                        <small class="text-muted">Ingrese el monto del descuento a aplicar</small>
                    </div>
                    
                    <div class="mb-3">
                        <label for="reason" class="form-label">Razón del Descuento</label>
                        <textarea class="form-control" 
                                  id="reason" 
                                  name="reason" 
                                  rows="3" 
                                  placeholder="Especifica la razón del descuento (ej: Beca, Promoción, Descuento por hermanos, etc.)" 
                                  required></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <div class="btn-group" role="group">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                            <i class="fas fa-arrow-left me-2"></i>Cancelar
                        </button>
                        <button type="submit" class="btn btn-warning">
                            <i class="fas fa-save me-2"></i>Aplicar Descuento
                        </button>
                    </div>

                </div>
            </form>
        </div>
    </div>
</div>
{% endif %}

<style>
.avatar-sm {
    width: 40px;
    height: 40px;
    font-size: 18px;
    font-weight: bold;
}
</style>
{% endblock %}