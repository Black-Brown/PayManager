{% extends "layout.html.twig" %}

{% block content %}
<div class="container-fluid">
    <div class="card shadow-sm mt-4">
        <div class="card-header bg-success text-white py-3 d-flex justify-content-between align-items-center">
            <h5 class="card-title mb-0">
                <i class="fas fa-money-check-alt me-2"></i>Lista de Pagos
            </h5>
            <a href="/payments/create" class="btn btn-light text-success">
                <i class="fas fa-plus me-2"></i>Registrar Pago
            </a>
        </div>
        <div class="card-body p-0">
            {% if payments %}
                <div class="table-responsive">
                    <table class="table table-hover table-striped mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="text-center" style="width: 60px;">#</th>
                                <th>Estudiante</th>
                                <th>Concepto</th>
                                <th>Monto</th>
                                <th>Fecha de Pago</th>
                                <th>Mes Correspondiente</th>
                                <th>Método</th>
                                <th>Referencia</th>
                                <th>Registrado por</th>
                                <th class="text-center" style="width: 160px;">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for payment in payments %}
                            <tr>
                                <td class="text-center fw-bold text-muted">{{ loop.index }}</td>
                                <td>{{ payment.student_name }}</td>
                                <td>{{ payment.concept_name }}</td>
                                <td><span class="badge bg-warning text-dark">${{ payment.amount }}</span></td>
                                <td>{{ payment.payment_date|date('d/m/Y') }}</td>
                                <td>{{ payment.corresponding_month|date('F Y') }}</td>
                                <td>{{ payment.payment_method }}</td>
                                <td>{{ payment.reference ?: '—' }}</td>
                                <td>{{ payment.registered_by }}</td>
                                <td class="text-center">
                                    <div class="btn-group" role="group">
                                        <a href="/payments/{{ payment.id }}/edit" 
                                           class="btn btn-sm btn-outline-success" 
                                           title="Editar pago">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        <a href="/payments/{{ payment.id }}/delete" 
                                           class="btn btn-sm btn-outline-danger" 
                                           title="Eliminar pago"
                                           onclick="return confirm('¿Estás seguro de que deseas eliminar este pago?');">
                                            <i class="fas fa-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% else %}
                <div class="text-center py-5">
                    <div class="mb-3"><i class="fas fa-money-check-alt fa-3x text-muted"></i></div>
                    <h5 class="text-muted">No se encontraron pagos registrados</h5>
                    <p class="text-muted mb-4">Comienza registrando el primer pago en el sistema</p>
                    <a href="/payments/create" class="btn btn-success">
                        <i class="fas fa-plus me-2"></i>Registrar Primer Pago
                    </a>
                </div>
            {% endif %}
        </div>
        {% if payments %}
        <div class="card-footer bg-light text-muted">
            <small><i class="fas fa-info-circle me-1"></i>Total de pagos: {{ payments|length }}</small>
        </div>
        {% endif %}
    </div>
</div>
{% endblock %}
