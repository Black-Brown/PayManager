{% extends 'base.html.twig' %}

{% block styles %}
  <link href="assets/auth/style.css" rel="stylesheet">
{% endblock %}

{% block body %}
<div class="login-container">
    <div class="login-header">
        <div class="login-icon"><i class="fa-solid fa-credit-card"></i></div>
        <h1 class="login-title">Control de Pagos</h1>
        <p class="login-subtitle">Sistema de Gestión Escolar</p>
    </div>

    {# Mostrar errores del backend (flash) #}
    {% if error %}
        <div class="alert error show">{{ error }}</div>
    {% endif %}

    <form class="login-form" method="POST" action="/login">
        <div class="form-group">
            <label for="email" class="form-label">Correo Electrónico</label>
            <input type="email" id="email" name="email" class="form-input"
                   placeholder="ejemplo@correo.com"
                   value="{{ old.email ?? '' }}" required>
            <span class="input-icon"><i class="fa-solid fa-envelope"></i></span>
        </div>

        <div class="form-group">
            <label for="password" class="form-label">Contraseña</label>
            <input type="password" id="password" name="password" class="form-input"
                   placeholder="Ingrese su contraseña" required>
            <span class="input-icon password-toggle" onclick="togglePassword()"><i class="fa-solid fa-eye-slash"></i></span>
        </div>

        <div class="remember-forgot">
            <label class="remember-me">
                <input type="checkbox" class="checkbox" id="remember">
                Recordarme
            </label>
            <a href="#" class="forgot-password">¿Olvidaste tu contraseña?</a>
        </div>

        <button type="submit" class="login-button">
            Iniciar Sesión
        </button>
    </form>
    <div class="footer" style="margin-top:18px;">
        <p style="margin-top:8px;">&copy; {{ "now"|date("Y") }} Sistema de Control de Pagos Escolares</p>
    </div>
</div>
{% endblock %}

{% block scripts %}
  <script src="assets/auth/main.js"></script>
{% endblock %}
