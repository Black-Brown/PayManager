{% extends "layout.html.twig" %}

{% block title %}Editar Grado Académico{% endblock %}

{% block content %}
<div class="container-fluid">
  <div class="card shadow-sm mt-4">
    <div class="card-header bg-warning text-dark py-3">
      <h5 class="card-title mb-0">
        <i class="fas fa-plus-circle me-2"></i>Editar Grado Académico
      </h5>
    </div>
    <div class="card-body">
      <form action="/grades/{{ grade.id }}/update" method="POST" id="gradeForm" novalidate>
        <input type="hidden" name="id" value="{{ grade.id }}">
        <div class="row">
          <!-- Nombre -->
          <div class="col-md-6 mb-4">
            <label for="name" class="form-label fw-semibold">
              <i class="fas fa-tag me-1 text-muted"></i>Nombre del Grado <span class="text-danger">*</span>
            </label>
            <input type="text" 
                   class="form-control" 
                   id="name" 
                   name="name"
                   value="{{ grade.name }}"
                   placeholder="Ej: Primer Grado, Segundo Grado..."
                   required
                   maxlength="50">
          </div>

          <!-- Nivel -->
          <div class="col-md-6 mb-4">
            <label for="level" class="form-label fw-semibold">
              <i class="fas fa-layer-group me-1 text-muted"></i>Nivel <span class="text-danger">*</span>
            </label>
            <select class="form-control" id="level" name="level" required>
              <option value=""> {{grade.level}} </option>
              {% for nivel in niveles %}
              <option value="{{ nivel }}" {% if grade.level == nivel %}selected{% endif %}>{{ nivel }}</option>
              {% endfor %}
            </select>
          </div>

          <!-- Orden -->
          <div class="col-md-6 mb-4">
            <label for="grade_order" class="form-label fw-semibold">
              <i class="fas fa-sort-numeric-up me-1 text-muted"></i>Orden <span class="text-danger">*</span>
            </label>
            <input type="number" 
                   class="form-control" 
                   id="grade_order" 
                   name="grade_order" 
                   value="{{ grade.grade_order }}"
                   placeholder="Ej: 1, 2, 3..."
                   required
                   min="1"
                   max="20">
          </div>
        </div>

        <div class="row mt-4">
          <div class="col-12">
            <div class="d-flex justify-content-between align-items-center border-top pt-3">
              <a href="/grades" class="btn btn-outline-secondary">
                <i class="fas fa-arrow-left me-2"></i>Cancelar
              </a>
              <button type="submit" class="btn btn-warning">
                <i class="fas fa-save me-2"></i>Guardar Grado
              </button>
            </div>
          </div>
        </div>
      </form>
    </div>
  </div>
</div>
{% endblock %}
