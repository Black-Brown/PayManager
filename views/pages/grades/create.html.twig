{% extends "layout.html.twig" %}

{% block title %}Crear Grado Académico{% endblock %}

{% block content %}
<div class="container-fluid">
  <!-- Form Card -->
  <div class="card shadow-sm mt-4">
    <div class="card-header bg-primary text-white py-3">
      <h5 class="card-title mb-0">
        <i class="fas fa-plus-circle me-2"></i>Crear Nuevo Grado Académico
      </h5>
    </div>
    <div class="card-body">
      <form action="/grades" method="POST" id="gradeForm" novalidate>
        <div class="row">
          {% if error %}
            <div class="alert alert-danger">
                <i class="fas fa-exclamation-triangle me-2"></i>{{ error }}
            </div>
          {% endif %}
          <!-- Nombre del Grado -->
          <div class="col-md-6 mb-4">
            <label for="name" class="form-label fw-semibold">
              <i class="fas fa-tag me-1 text-muted"></i>Nombre del Grado <span class="text-danger">*</span>
            </label>
            <input type="text" 
                   class="form-control" 
                   id="name" 
                   name="name" 
                   placeholder="Ej: Primer Grado, Segundo Grado..."
                   value = "{{ old.name }}"
                   required
                   maxlength="50">
            <div class="invalid-feedback">
              Por favor, ingrese un nombre válido para el grado.
            </div>
            <div class="form-text">
              <i class="fas fa-info-circle me-1"></i>Máximo 50 caracteres
            </div>
          </div>

            <!-- Nivel del Grado -->
            <div class="col-md-6 mb-4">
              <label for="level" class="form-label fw-semibold">
                <i class="fas fa-layer-group me-1 text-muted"></i>Nivel <span class="text-danger">*</span>
              </label>

              <select class="form-control" id="level" name="level" required>
                <option value="">Seleccione un nivel</option>
                {% for lvl in levels %}
                <option value="{{ lvl }}" {{ (old.level ?? '') == lvl ? 'selected' : '' }}>
                  {{ lvl }}
                </option>
                {% endfor %}
              </select>

              <div class="invalid-feedback">
                Por favor, seleccione un nivel.
              </div>
            </div>

          <!-- Orden del Grado -->
          <div class="col-md-6 mb-4">
            <label for="grade_order" class="form-label fw-semibold">
              <i class="fas fa-sort-numeric-up me-1 text-muted"></i>Orden <span class="text-danger">*</span>
            </label>
            <input type="number" 
                   class="form-control" 
                   id="grade_order" 
                   name="grade_order" 
                   placeholder="Ej: 1, 2, 3..."
                   value="{{ old.grade_order }}"
                   required
                   min="1"
                   max="20">
            <div class="invalid-feedback">
              Por favor, ingrese un orden válido (1-20).
            </div>
            <div class="form-text">
              <i class="fas fa-info-circle me-1"></i>Número de orden para organizar los grados
            </div>
          </div>
        </div>

        <!-- Botones de Acción -->
        <div class="row mt-4">
          <div class="col-12">
            <div class="d-flex justify-content-between align-items-center border-top pt-3">
              <div class="text-muted small">
                <i class="fas fa-asterisk me-1"></i>Los campos marcados con <span class="text-danger">*</span> son obligatorios
              </div>
              <div class="btn-group" role="group">
                <a href="/grades" class="btn btn-outline-secondary">
                  <i class="fas fa-arrow-left me-2"></i>Cancelar
                </a>
                <button type="submit" class="btn btn-primary">
                  <i class="fas fa-save me-2"></i>Guardar Grado
                </button>
              </div>
            </div>
          </div>
        </div>
      </form>
    </div>
  </div>
</div>

{% endblock %}
