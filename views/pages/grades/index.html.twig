{% extends "layout.html.twig" %}

{% block content %}
<div class="container-fluid">
  <div class="card shadow-sm mt-4">
    <div class="card-header bg-primary text-white py-3 d-flex justify-content-between align-items-center">
      <h5 class="card-title mb-0">
        <i class="fas fa-graduation-cap me-2"></i>Lista de Grados
      </h5>
      <a href="/grades/create" class="btn btn-light text-primary">
        <i class="fas fa-plus me-2"></i>Agregar Grado
      </a>
    </div>
    <div class="card-body p-0">
      {% if grades %}
        <div class="table-responsive">
          <table class="table table-hover table-striped mb-0">
            <thead class="table-light">
              <tr>
                <th scope="col" class="text-center" style="width: 60px;">#</th>
                <th scope="col">Nombre</th>
                <th scope="col">Nivel</th>
                <th scope="col" class="text-center" style="width: 100px;">Orden</th>
                <th scope="col" class="text-center" style="width: 200px;">Acciones</th>
              </tr>
            </thead>
            <tbody>
              {% for grade in grades %}
              <tr>
                <td class="text-center fw-bold text-muted">{{ loop.index }}</td>
                <td class="fw-semibold">{{ grade.name }}</td>
                <td><span class="badge bg-secondary">{{ grade.level }}</span></td>
                <td class="text-center"><span class="badge bg-info">{{ grade.grade_order }}</span></td>
                <td class="text-center">
                  <div class="btn-group" role="group" aria-label="Acciones">
                    <!-- Editar -->
                    <a href="/grades/{{ grade.id }}/edit" 
                       class="btn btn-sm btn-outline-primary" 
                       title="Editar grado">
                      <i class="fas fa-edit"></i>
                    </a>

                    <!-- Eliminar -->
                    <a href="/grades/{{ grade.id }}/delete" 
                       class="btn btn-sm btn-outline-danger" 
                       title="Eliminar grado"
                       onclick="return confirm('¿Estás seguro de que deseas eliminar este grado?');">
                      <i class="fas fa-trash"></i>
                    </a>
                  </div>
                </td>
              </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
      {% else %}
        <div class="text-center py-5">
          <div class="mb-3"><i class="fas fa-graduation-cap fa-3x text-muted"></i></div>
          <h5 class="text-muted">No se encontraron grados académicos</h5>
          <p class="text-muted mb-4">Comienza agregando el primer grado académico al sistema</p>
          <a href="/grades/create" class="btn btn-primary">
            <i class="fas fa-plus me-2"></i>Agregar Primer Grado
          </a>
        </div>
      {% endif %}
    </div>
    {% if grades %}
    <div class="card-footer bg-light text-muted">
      <small><i class="fas fa-info-circle me-1"></i>Total de grados: {{ grades|length }}</small>
    </div>
    {% endif %}
  </div>
</div>
{% endblock %}
