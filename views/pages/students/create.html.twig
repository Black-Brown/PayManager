{% extends "layout.html.twig" %}

{% block title %}Crear Estudiante{% endblock %}

{% block content %}
<div class="container-fluid">
  <div class="card shadow-sm mt-4 mb-4">
    <div class="card-header bg-primary text-white py-3">
      <h5 class="card-title mb-0">
        <i class="fas fa-user-plus me-2"></i>Crear Nuevo Estudiante
      </h5>
    </div>
    <div class="card-body">
      <form action="/students" method="POST" id="studentForm" novalidate>
        <div class="row">
        {% if error %}
            <div class="alert alert-danger">
                <i class="fas fa-exclamation-triangle me-2"></i>{{ error }}
            </div>
        {% endif %}
          <!-- ID del ministerio -->
          <div class="col-md-6 mb-4">
            <label for="ministry_id" class="form-label fw-semibold">ID del ministerio <span class="text-danger">*</span></label>
            <input type="text" class="form-control" id="ministry_id" name="ministry_id" required maxlength="100">
          </div>

          <!-- Nombre -->
          <div class="col-md-6 mb-4">
            <label for="first_name" class="form-label fw-semibold">Nombre <span class="text-danger">*</span></label>
            <input type="text" class="form-control" id="first_name" name="first_name" required maxlength="100">
          </div>

          <!-- Apellido -->
          <div class="col-md-6 mb-4">
            <label for="last_name" class="form-label fw-semibold">Apellido <span class="text-danger">*</span></label>
            <input type="text" class="form-control" id="last_name" name="last_name" required maxlength="100">
          </div>

          <!-- Fecha de nacimiento -->
          <div class="col-md-6 mb-4">
            <label for="birth_date" class="form-label fw-semibold">Fecha de nacimiento</label>
            <input type="date" class="form-control" id="birth_date" name="birth_date">
          </div>

          <!-- Género -->
          <div class="col-md-6 mb-4">
            <label for="gender" class="form-label fw-semibold">Género</label>
            <select class="form-control" id="gender" name="gender">
              <option value="">Seleccione</option>
              <option value="Masculino">Masculino</option>
              <option value="Femenino">Femenino</option>
              <option value="Otro">Otro</option>
            </select>
          </div>

          <!-- Grado -->
          <div class="col-md-6 mb-4">
            <label for="grade_id" class="form-label fw-semibold">Grado <span class="text-danger">*</span></label>
            <select class="form-control" id="grade_id" name="grade_id" required>
              <option value="">Seleccione un grado</option>
              {% for grade in grades %}
              <option value="{{ grade.id }}">{{ grade.name }} - {{ grade.level }}</option>
              {% endfor %}
            </select>
          </div>

          <!-- Nombre del tutor -->
          <div class="col-md-6 mb-4">
            <label for="guardian_name" class="form-label fw-semibold">Nombre del tutor</label>
            <input type="text" class="form-control" id="guardian_name" name="guardian_name" maxlength="100">
          </div>

          <!-- Teléfono del tutor -->
          <div class="col-md-6 mb-4">
            <label for="guardian_phone" class="form-label fw-semibold">Teléfono del tutor</label>
            <input type="text" class="form-control" id="guardian_phone" name="guardian_phone" maxlength="20">
          </div>

        <!-- Botones -->
        <div class="row mt-4">
          <div class="col-12">
            <div class="d-flex justify-content-between align-items-center border-top pt-3">
              <div class="text-muted small">
                <i class="fas fa-asterisk me-1"></i>Los campos marcados con <span class="text-danger">*</span> son obligatorios
              </div>
              <div class="btn-group" role="group">
                <a href="/students" class="btn btn-outline-secondary">
                  <i class="fas fa-arrow-left me-2"></i>Cancelar
                </a>
                <button type="submit" class="btn btn-primary">
                  <i class="fas fa-save me-2"></i>Guardar Estudiante
                </button>
              </div>
            </div>
          </div>
        </div>
      </form>
    </div>
  </div>
</div>
{% endblock %}
