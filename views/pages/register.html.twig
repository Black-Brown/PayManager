{% extends 'base.html.twig' %}

{% block styles %}
  <link href="assets/auth/style.css" rel="stylesheet">
{% endblock %}

{% block body %}
<div class="register-container">
    <div class="register-header">
        <div class="register-icon"><i class="fa-solid fa-credit-card"></i></div>
        <h1 class="register-title">Crear cuenta</h1>
        <p class="register-subtitle">Regístrate para acceder al sistema</p>
    </div>

    {% if error %}
        <div class="alert error show">{{ error }}</div>
    {% endif %}
    {% if success %}
        <div class="alert success show">{{ success }}</div>
    {% endif %}

    <form class="register-form" method="POST" action="/register" id="registerForm" novalidate>
        <div class="form-group">
            <label for="name" class="form-label">Nombre completo</label>
            <input type="text" id="name" name="name" class="form-input"
                   placeholder="Tu nombre completo" value="{{ old.name ?? '' }}" required>
            <span class="input-icon"><i class="fa-solid fa-user"></i></span>
            <div class="error-message" id="nameError"></div>
        </div>

        <div class="form-group">
            <label for="email" class="form-label">Correo Electrónico</label>
            <input type="email" id="email" name="email" class="form-input"
                   placeholder="ejemplo@correo.com" value="{{ old.email ?? '' }}" required>
            <span class="input-icon"><i class="fa-solid fa-envelope"></i></span>
            <div class="error-message" id="emailError"></div>
        </div>

        <div class="form-group">
            <label for="password" class="form-label">Contraseña</label>
            <input type="password" id="password" name="password" class="form-input"
                   placeholder="Ingrese una contraseña" required>
            <div class="error-message" id="passwordError"></div>
        </div>

        <div class="form-group">
            <label for="password_confirm" class="form-label">Confirmar contraseña</label>
            <input type="password" id="password_confirm" name="password_confirm" class="form-input"
                   placeholder="Repita la contraseña" required>
            <div class="error-message" id="password_confirmError"></div>
        </div>

        <div class="form-group">
            <label for="role" class="form-label">Rol</label>
            <select id="role" name="role" class="form-input">
                <option value="user" {% if old.role is defined and old.role == 'user' %}selected{% endif %}>User</option>
                <option value="admin" {% if old.role is defined and old.role == 'admin' %}selected{% endif %}>Admin</option>
            </select>
            <div class="error-message" id="roleError"></div>
        </div>

        <button type="submit" class="register-button" id="registerButton">
            <span id="buttonText">Crear Cuenta</span>
        </button>
    </form>

    <div class="footer" style="margin-top:18px;">
        <p>¿Ya tienes una cuenta? <a href="/login" style="color:#3498db; text-decoration:none;">Inicia sesión</a></p>
        <p style="margin-top:8px;">&copy; {{ "now"|date("Y") }} Sistema de Control de Pagos Escolares</p>
    </div>
</div>
{% endblock %}
