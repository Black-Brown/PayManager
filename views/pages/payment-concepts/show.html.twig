{% extends "layout.html.twig" %}

{% block content %}
<div class="container-fluid">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="card shadow-sm mt-4">
                <div class="card-header bg-primary text-white py-3 d-flex justify-content-between align-items-center">
                    <h5 class="card-title mb-0">
                        <i class="fas fa-eye me-2"></i>Detalle del Concepto: {{ concept.name }}
                    </h5>
                    <div class="d-flex gap-2">
                        <a href="/payment-concepts/{{ concept.id }}/edit" class="btn btn-light text-primary">
                            <i class="fas fa-edit me-2"></i>Editar
                        </a>
                        <a href="/payment-concepts" class="btn btn-light text-primary">
                            <i class="fas fa-arrow-left me-2"></i>Volver
                        </a>
                    </div>
                </div>
                <div class="card-body">
                    <div class="row">
                        <!-- Información Principal -->
                        <div class="col-md-8">
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-bold text-muted">Nombre del Concepto</label>
                                    <div class="fs-5 fw-semibold">{{ concept.name }}</div>
                                </div>

                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-bold text-muted">Tipo</label>
                                    <div>
                                        {% if concept.type == 'Enrollment' %}
                                            <span class="badge bg-success fs-6">Inscripción</span>
                                        {% elseif concept.type == 'Reenrollment' %}
                                            <span class="badge bg-info fs-6">Reinscripción</span>
                                        {% elseif concept.type == 'Monthly' %}
                                            <span class="badge bg-warning text-dark fs-6">Mensual</span>
                                        {% else %}
                                            <span class="badge bg-secondary fs-6">Otro</span>
                                        {% endif %}
                                    </div>
                                </div>

                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-bold text-muted">Monto</label>
                                    <div class="fs-4 fw-bold text-primary">${{ concept.amount|number_format(2) }}</div>
                                </div>

                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-bold text-muted">Frecuencia</label>
                                    <div>
                                        {% if concept.frequency == 'One-time' %}
                                            <span class="badge bg-light text-dark fs-6">Único</span>
                                        {% elseif concept.frequency == 'Monthly' %}
                                            <span class="badge bg-light text-dark fs-6">Mensual</span>
                                        {% elseif concept.frequency == 'Yearly' %}
                                            <span class="badge bg-light text-dark fs-6">Anual</span>
                                        {% else %}
                                            <span class="badge bg-light text-dark fs-6">{{ concept.frequency }}</span>
                                        {% endif %}
                                    </div>
                                </div>

                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-bold text-muted">Descuentos</label>
                                    <div>
                                        {% if concept.discount_applicable %}
                                            <span class="badge bg-success fs-6">
                                                <i class="fas fa-check me-1"></i>Permitidos
                                            </span>
                                        {% else %}
                                            <span class="badge bg-danger fs-6">
                                                <i class="fas fa-times me-1"></i>No Permitidos
                                            </span>
                                        {% endif %}
                                    </div>
                                </div>

                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-bold text-muted">Estado</label>
                                    <div>
                                        {% if concept.active %}
                                            <span class="badge bg-success fs-6">Activo</span>
                                        {% else %}
                                            <span class="badge bg-secondary fs-6">Inactivo</span>
                                        {% endif %}
                                    </div>
                                </div>

                                {% if concept.description %}
                                <div class="col-12 mb-3">
                                    <label class="form-label fw-bold text-muted">Descripción</label>
                                    <div class="bg-light p-3 rounded">{{ concept.description }}</div>
                                </div>
                                {% endif %}
                            </div>
                        </div>

                        <!-- Panel de Estadísticas -->
                        <div class="col-md-4">
                            <div class="card border-primary mb-3">
                                <div class="card-header bg-primary text-white">
                                    <h6 class="mb-0">
                                        <i class="fas fa-chart-bar me-2"></i>Estadísticas
                                    </h6>
                                </div>
                                <div class="card-body">
                                    <div class="mb-3">
                                        <small class="text-muted">Total de Pagos</small>
                                        <div class="fw-semibold fs-5">{{ totalPayments }}</div>
                                    </div>
                                    
                                    <div class="mb-3">
                                        <small class="text-muted">Monto Total Recaudado</small>
                                        <div class="fw-semibold fs-5 text-success">${{ totalAmount|number_format(2) }}</div>
                                    </div>

                                    {% if totalPayments > 0 %}
                                    <div class="mb-3">
                                        <small class="text-muted">Promedio por Pago</small>
                                        <div class="fw-semibold fs-5 text-info">${{ (totalAmount / totalPayments)|number_format(2) }}</div>
                                    </div>
                                    {% endif %}

                                    <hr>
                                    <div class="text-center">
                                        <a href="/payments?concept={{ concept.id }}" class="btn btn-outline-primary btn-sm">
                                            <i class="fas fa-list me-2"></i>Ver Pagos
                                        </a>
                                    </div>
                                </div>
                            </div>

                            <!-- Panel de Información Adicional -->
                            <div class="card border-secondary">
                                <div class="card-header bg-secondary text-white">
                                    <h6 class="mb-0">
                                        <i class="fas fa-info-circle me-2"></i>Información Adicional
                                    </h6>
                                </div>
                                <div class="card-body">
                                    <div class="mb-3">
                                        <small class="text-muted">ID del Concepto</small>
                                        <div class="fw-semibold">#{{ concept.id }}</div>
                                    </div>
                                    
                                    <div class="mb-3">
                                        <small class="text-muted">Fecha de Creación</small>
                                        <div class="fw-semibold">{{ concept.created_at|date('d/m/Y H:i') }}</div>
                                    </div>

                                    {% if concept.updated_at != concept.created_at %}
                                    <div class="mb-3">
                                        <small class="text-muted">Última Actualización</small>
                                        <div class="fw-semibold">{{ concept.updated_at|date('d/m/Y H:i') }}</div>
                                    </div>
                                    {% endif %}

                                    <hr>
                                    <div class="d-grid gap-2">
                                        <a href="/payment-concepts/{{ concept.id }}/duplicate" 
                                           class="btn btn-outline-warning btn-sm"
                                           onclick="return confirm('¿Duplicar este concepto?');">
                                            <i class="fas fa-copy me-2"></i>Duplicar Concepto
                                        </a>
                                        <a href="/payment-concepts/{{ concept.id }}/toggle-status" 
                                           class="btn btn-outline-secondary btn-sm">
                                            <i class="fas fa-{% if concept.active %}pause{% else %}play{% endif %} me-2"></i>
                                            {% if concept.active %}Desactivar{% else %}Activar{% endif %}
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
