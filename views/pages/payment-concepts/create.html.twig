{% extends "layout.html.twig" %}

{% block content %}
<div class="container-fluid">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm mt-4">
                <div class="card-header bg-primary text-white py-3">
                    <h5 class="card-title mb-0">
                        <i class="fas fa-plus me-2"></i>Crear Nuevo Concepto de Pago
                    </h5>
                </div>
                <div class="card-body">
                    {% if error %}
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <i class="fas fa-exclamation-triangle me-2"></i>{{ error }}
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    {% endif %}

                    <form method="POST" action="/payment-concepts">
                        <div class="row">
                            <!-- Nombre del Concepto -->
                            <div class="col-md-6 mb-3">
                                <label for="name" class="form-label">
                                    <i class="fas fa-tag me-1"></i>Nombre del Concepto <span class="text-danger">*</span>
                                </label>
                                <input type="text" 
                                       class="form-control" 
                                       id="name" 
                                       name="name" 
                                       value="{{ old.name }}" 
                                       placeholder="Ej: Inscripción Primaria"
                                       required>
                            </div>

                            <!-- Tipo de Concepto -->
                            <div class="col-md-6 mb-3">
                                <label for="type" class="form-label">
                                    <i class="fas fa-list me-1"></i>Tipo de Concepto <span class="text-danger">*</span>
                                </label>
                                <select class="form-select" id="type" name="type" required>
                                    <option value="">Seleccionar tipo...</option>
                                    <option value="Enrollment" {% if old.type == 'Enrollment' %}selected{% endif %}>Inscripción</option>
                                    <option value="Reenrollment" {% if old.type == 'Reenrollment' %}selected{% endif %}>Reinscripción</option>
                                    <option value="Monthly" {% if old.type == 'Monthly' %}selected{% endif %}>Mensual</option>
                                    <option value="Other" {% if old.type == 'Other' %}selected{% endif %}>Otro</option>
                                </select>
                            </div>

                            <!-- Monto -->
                            <div class="col-md-6 mb-3">
                                <label for="amount" class="form-label">
                                    <i class="fas fa-dollar-sign me-1"></i>Monto <span class="text-danger">*</span>
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text">$</span>
                                    <input type="number" 
                                           class="form-control" 
                                           id="amount" 
                                           name="amount" 
                                           step="0.01" 
                                           min="0" 
                                           value="{{ old.amount }}" 
                                           placeholder="0.00"
                                           required>
                                </div>
                            </div>

                            <!-- Frecuencia -->
                            <div class="col-md-6 mb-3">
                                <label for="frequency" class="form-label">
                                    <i class="fas fa-calendar me-1"></i>Frecuencia
                                </label>
                                <select class="form-select" id="frequency" name="frequency">
                                    <option value="One-time" {% if old.frequency == 'One-time' %}selected{% endif %}>Único</option>
                                    <option value="Monthly" {% if old.frequency == 'Monthly' %}selected{% endif %}>Mensual</option>
                                    <option value="Yearly" {% if old.frequency == 'Yearly' %}selected{% endif %}>Anual</option>
                                </select>
                            </div>

                            <!-- Opciones -->
                            <div class="col-12 mb-3">
                                <div class="card">
                                    <div class="card-header">
                                        <h6 class="mb-0">Opciones</h6>
                                    </div>
                                    <div class="card-body">
                                        <div class="row">
                                            <div class="col-md-6">
                                                <div class="form-check">
                                                    <input class="form-check-input" 
                                                           type="checkbox" 
                                                           id="discount_applicable" 
                                                           name="discount_applicable" 
                                                           value="1"
                                                           {% if old.discount_applicable %}checked{% endif %}>
                                                    <label class="form-check-label" for="discount_applicable">
                                                        <i class="fas fa-tag me-1"></i>Permite Descuentos
                                                    </label>
                                                    <small class="form-text text-muted d-block">
                                                        Los usuarios podrán aplicar descuentos a los pagos de este concepto
                                                    </small>
                                                </div>
                                            </div>
                                            <div class="col-md-6">
                                                <div class="form-check">
                                                    <input class="form-check-input" 
                                                           type="checkbox" 
                                                           id="active" 
                                                           name="active" 
                                                           value="1"
                                                           {% if old.active is not defined or old.active %}checked{% endif %}>
                                                    <label class="form-check-label" for="active">
                                                        <i class="fas fa-check-circle me-1"></i>Activo
                                                    </label>
                                                    <small class="form-text text-muted d-block">
                                                        El concepto estará disponible para usar inmediatamente
                                                    </small>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <div class="btn-group" role="group">
                                <a href="/payment-concepts" class="btn btn-secondary">
                                    <i class="fas fa-arrow-left me-2"></i>Cancelar
                                </a>
                                <button type="submit" class="btn btn-primary">
                                    <i class="fas fa-save me-2"></i>Crear Concepto
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
